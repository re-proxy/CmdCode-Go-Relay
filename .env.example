# --- required -----------------------------------------------------------
RELAY_ADMIN_PASSWORD=change-me-to-a-long-random-password

# 32 random bytes, standard Base64. Generate with:
#   docker compose run --rm --no-deps relay keygen
# Never rotate this after accounts exist: stored credentials become unreadable.
RELAY_MASTER_KEY=

# --- optional -----------------------------------------------------------
# RELAY_PORT=8317
# RELAY_HOST=0.0.0.0
# Public origin used to build the login callback. Leave unset to derive it
# from the request (honours X-Forwarded-Proto / X-Forwarded-Host).
# RELAY_PUBLIC_URL=
# RELAY_DATA_FILE=/data/relay.json
# RELAY_UPSTREAM_BASE=https://api.commandcode.ai
# RELAY_STUDIO_BASE=https://commandcode.ai
# RELAY_CLI_VERSION=1.89.2
# RELAY_CLI_ENVIRONMENT=production
# RELAY_PROJECT_SLUG=relay
# RELAY_MAX_CONCURRENT=4
# RELAY_ACCOUNT_QUEUE_MS=60000
# RELAY_MAX_OUTPUT_TOKENS=32000
# RELAY_UPSTREAM_TIMEOUT_MS=120000
# RELAY_CATALOG_TTL_MS=900000
# RELAY_SESSION_TTL_MS=43200000
# RELAY_USAGE_LIMIT=500
